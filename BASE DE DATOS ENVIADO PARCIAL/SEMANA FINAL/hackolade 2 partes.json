use CogniAI_NoSQL;

db.createCollection("estado_cognitivo_equipo", {
    "capped": false,
    "validator": {
        "$jsonSchema": {
            "bsonType": "object",
            "title": "estado_cognitivo_equipo",
            "properties": {
                "_id": {
                    "bsonType": "objectId"
                },
                "codigo_usuario": {
                    "bsonType": "int",
                    "minimum": 1
                },
                "codigo_empresa": {
                    "bsonType": "int",
                    "minimum": 1
                },
                "codigo_proyecto_activo": {
                    "bsonType": "int",
                    "minimum": 1
                },
                "nombre_completo": {
                    "bsonType": "string",
                    "minLength": 3
                },
                "rol_corporativo": {
                    "bsonType": "string",
                    "enum": [
                        "Lider Tecnico",
                        "Desarrollador",
                        "QA",
                        "Arquitecto",
                        "Estudiante"
                    ]
                },
                "ultima_sesion_id": {
                    "bsonType": "objectId"
                },
                "estado_actual": {
                    "bsonType": "object",
                    "properties": {
                        "score_cognitivo": {
                            "bsonType": "int",
                            "maximum": 100,
                            "minimum": 0
                        },
                        "semaforo": {
                            "bsonType": "string",
                            "enum": [
                                "Verde",
                                "Amarillo",
                                "Rojo"
                            ]
                        },
                        "diagnostico": {
                            "bsonType": "string",
                            "enum": [
                                "Optimo",
                                "Precaucion",
                                "Fatiga_Critica",
                                "Bloqueo_Conocimiento"
                            ]
                        },
                        "disponible_para_criticas": {
                            "bsonType": "bool"
                        },
                        "actualizado_en": {
                            "bsonType": "date"
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "score_cognitivo",
                        "semaforo",
                        "diagnostico",
                        "disponible_para_criticas",
                        "actualizado_en"
                    ]
                },
                "resumen_biometrico_actual": {
                    "bsonType": "object",
                    "properties": {
                        "latencia_promedio_ms": {
                            "bsonType": "int",
                            "minimum": 0
                        },
                        "errores_sintaxis_min": {
                            "bsonType": "double",
                            "minimum": 0
                        },
                        "parpadeos_por_minuto": {
                            "bsonType": "int",
                            "minimum": 0
                        },
                        "microsuenos_ultima_hora": {
                            "bsonType": "int",
                            "minimum": 0
                        }
                    },
                    "additionalProperties": false,
                    "required": [
                        "latencia_promedio_ms",
                        "errores_sintaxis_min",
                        "parpadeos_por_minuto",
                        "microsuenos_ultima_hora"
                    ]
                },
                "ultimas_alertas": {
                    "bsonType": "array",
                    "additionalItems": true,
                    "items": {
                        "bsonType": "object",
                        "properties": {
                            "alerta_id": {
                                "bsonType": "objectId"
                            },
                            "tipo_evento": {
                                "bsonType": "string",
                                "enum": [
                                    "Fatiga_Critica",
                                    "Bloqueo_Conocimiento"
                                ]
                            },
                            "severidad": {
                                "bsonType": "string",
                                "enum": [
                                    "Baja",
                                    "Media",
                                    "Alta"
                                ]
                            },
                            "accion_tomada": {
                                "bsonType": "string",
                                "enum": [
                                    "Descanso_Aceptado",
                                    "Alerta_Ignorada",
                                    "Guardada_Para_Repaso"
                                ]
                            },
                            "fecha_evento": {
                                "bsonType": "date"
                            }
                        },
                        "additionalProperties": false,
                        "required": [
                            "alerta_id",
                            "tipo_evento",
                            "severidad",
                            "accion_tomada",
                            "fecha_evento"
                        ]
                    },
                    "maxItems": 3,
                    "minItems": 0
                }
            },
            "additionalProperties": false,
            "required": [
                "_id",
                "codigo_usuario",
                "nombre_completo",
                "rol_corporativo",
                "ultima_sesion_id",
                "estado_actual",
                "resumen_biometrico_actual",
                "ultimas_alertas"
            ]
        }
    },
    "validationLevel": "strict",
    "validationAction": "error"
});




