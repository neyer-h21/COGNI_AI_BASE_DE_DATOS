    "memoEntities": {
      "4Vo9TqBb1UeIIY67kChgs": {
        "id": "4Vo9TqBb1UeIIY67kChgs",
        "value": "UNA TAREA PUEDE ESTAR SIN SER ASIGNADA A NADIE O SE ASIGNA A UNA PERSONA PERO SI ESA PERSONA NO LO TERMINA O SE ENFERMA, ENTONCES SE PUEDE ASIGNAR A OTRA PERSONA, POR ESO ES DE CERO A MUCHOS",
        "ui": {
          "x": 465.4734,
          "y": -1695.1734,
          "zIndex": 825,
          "width": 143.3504273504274,
          "height": 170.94017094017082,
          "color": ""
        },
        "meta": {
          "updateAt": 1791000659902,
          "createAt": 1791000177786
        }
      },
      "QrbMnYljXaAGrECgoEJGY": {
        "id": "QrbMnYljXaAGrECgoEJGY",
        "value": "UN USUARIO CON ROL DE DESARROLLADOR DE LA EMPRESA PUEDE RECIBIR VARIAS INVITACIONES DE UNIRSE A PROYECTOS",
        "ui": {
          "x": 186.8414,
          "y": -982.3531,
          "zIndex": 838,
          "width": 188.64957264957272,
          "height": 100.00000000000007,
          "color": ""
        },
        "meta": {
          "updateAt": 1791000591273,
