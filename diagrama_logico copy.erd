        }
      },
      "P6lEZ3U4JqPyfndQoSf_m": {
        "id": "P6lEZ3U4JqPyfndQoSf_m",
        "value": "SOLO SI EL DESARROLLADOR ACEPTA LA INVITACION, ES ASIGNADO AL PROYECTO, POR ESO AL INICIO LA RELACION ES DE CERO Y COMO MAXIMO 1",
        "ui": {
          "x": 178.2944,
          "y": -1425.9429,
          "zIndex": 843,
          "width": 217.70940170940173,
          "height": 100,
          "color": ""
        },
        "meta": {
          "updateAt": 1791000661741,
          "createAt": 1791000544681
        }
      },
      "SXcSZyPZJRjXgnkPlDi0_": {
        "id": "SXcSZyPZJRjXgnkPlDi0_",
        "value": "ESTO SOLO SE ACTIVA SI EL LIDER DE PROYECTO QUIERE ASIGNAR A UN DESARROLLADOR CANSADO CON PUNTUACION DE FATIGA",
        "ui": {
          "x": 920.1744,
          "y": -1783.2075,
          "zIndex": 867,
          "width": 136.51282051282053,
          "height": 106.83760683760683,
          "color": ""
